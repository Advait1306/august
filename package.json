{
  "name": "jupiter",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!website --filter=!litmus",
    "dev:website": "turbo run dev --filter=website",
    "dev:litmus": "turbo run dev --filter=litmus",
    "dev:all": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "worktree:add": "node scripts/worktree-add.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "standardwebhooks": "^1.0.0"
  }
}
