{
  "name": "@jupiter/sync",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@jupiter/typescript-config": "*",
    "@rocicorp/zero": "0.25.5",
    "electron": "^38.0.0",
    "mixpanel": "^0.18.1",
    "typescript": "latest"
  },
  "scripts": {
    "build": "tsc && tsc-esm-fix --target=dist",
    "zero:generate": "drizzle-zero generate --format --output ./src/zero/zero-schema.gen.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.20.6",
    "vitest": "^4.0.15"
  },
  "exports": {
    "./queries/*": {
      "types": "./src/queries/*.ts",
      "default": "./dist/queries/*.js"
    },
    "./zero/*": {
      "types": "./src/zero/*.ts",
      "default": "./dist/zero/*.js"
    },
    "./db/*": {
      "types": "./src/db/*.ts",
      "default": "./dist/db/*.js"
    },
    "./mutators/*": {
      "types": "./src/mutators/*.ts",
      "default": "./dist/mutators/*.js"
    },
    "./server-mutators/*": {
      "types": "./src/server-mutators/*.ts",
      "default": "./dist/server-mutators/*.js"
    }
  }
}
