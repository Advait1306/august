{
  "name": "shell",
  "version": "0.0.20",
  "description": "An app to manage agents that help you work",
  "main": "./out/main/bootstrap.js",
  "author": "sixhuman.com",
  "homepage": "https://august.tech",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "node scripts/build-and-notorize.js",
    "build:linux": "electron-vite build && electron-builder --linux",
    "publish": "node scripts/release.js",
    "publish:mac": "electron-builder --mac -p always",
    "publish:win": "electron-builder --win -p always",
    "publish:linux": "electron-builder --linux -p always"
  },
  "dependencies": {
    "@august/shell-tools": "*",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@jupiter/shared": "*",
    "@types/picomatch": "^4.0.2",
    "ai": "^5.0.60",
    "better-sqlite3": "12.4.1",
    "dodopayments": "^2.2.1",
    "drizzle-orm": "^0.44.5",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "fdir": "^6.5.0",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.3",
    "shell-env": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^3.1.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.16",
    "dotenv": "^17.2.2",
    "electron": "37.2.3",
    "electron-builder": "26.0.20",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^4.0.15"
  }
}
