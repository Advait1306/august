{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/", "out/", ".next"]
    },
    "shell#build": {
      "dependsOn": ["web#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["out/"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "build:mac": {
      "outputs": ["dist/"]
    }
  }
}
